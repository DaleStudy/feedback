{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback",
  "account_id": "94480614a6df7731f1e4491bdac5c440",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // GitHub App(dalestudy)의 Client ID. 로그인 URL에 그대로 드러나는 공개 값이다.
  "vars": { "GITHUB_CLIENT_ID": "Iv23liwu6Ob75w8NcAX9" },
  // 운영 도메인이 미리보기도 받는다(previews_enabled). 미리보기는 그 하위 도메인에 뜬다.
  "routes": [{ "pattern": "feedback.dalestudy.com", "custom_domain": true, "previews_enabled": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      "database_id": "6bbc1200-439a-42a5-8447-4e529f8a3537",
      "migrations_dir": "drizzle"
    }
  ],
  // PR 미리보기(Workers Previews). PR마다 pr-<번호>.feedback.dalestudy.com 에 뜬다.
  // D1 은 미리보기끼리 함께 쓰는 feedback-preview 로 — 프로덕션 응답을 건드리지 않게.
  "previews": {
    "vars": { "GITHUB_CLIENT_ID": "Iv23liwu6Ob75w8NcAX9" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "feedback-preview",
        "database_id": "0d7d18e8-1e8f-443a-96d3-c1c2afa4d4c7",
        "migrations_dir": "drizzle"
      }
    ]
  },
  // 미리보기 D1 마이그레이션 전용(`db:migrate:preview`). `d1 migrations apply` 는 `previews` 블록의 D1 을 못 찾는다.
  // `preview_database_id` 로 하면 로컬 개발도 그 id 의 빈 DB 를 쓰게 돼서 이렇게 둔다. 배포에는 쓰지 않는다.
  "env": {
    "migrate-preview": {
      "vars": { "GITHUB_CLIENT_ID": "Iv23liwu6Ob75w8NcAX9" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "feedback-preview",
          "database_id": "0d7d18e8-1e8f-443a-96d3-c1c2afa4d4c7",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
